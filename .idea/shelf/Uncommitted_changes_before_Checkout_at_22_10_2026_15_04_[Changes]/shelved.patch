0,0.1), 6, 0.3, 0, 4);\r\n\r\n}\r\n\r\n\r\n/* Botões azuis */\r\n.btn-azul {\r\n    -fx-background-color: #004587;\r\n    -fx-text-fill: white;\r\n    -fx-font-family: Verdana;\r\n}\r\n\r\n/* Hover dos botões azuis */\r\n.btn-azul:hover {\r\n    -fx-background-color: #003466;\r\n}\r\n\r\n/* Botões cinzas */\r\n.btn-cinza {\r\n    -fx-background-color: #efefef;\r\n    -fx-text-fill: #004587;\r\n    -fx-font-family: Verdana;\r\n}\r\n\r\n/* Hover dos botões cinzas */\r\n.btn-cinza:hover{\r\n    -fx-background-color: #dddddd;\r\n}\r\n
