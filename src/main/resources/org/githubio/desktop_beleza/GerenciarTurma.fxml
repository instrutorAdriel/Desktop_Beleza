<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.githubio.desktop_beleza.components.PainelLateralComponent?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="950.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.githubio.desktop_beleza.controller.GerenciarTurmaController">
    <top>
        <Pane prefHeight="70.0" prefWidth="600.0" style="-fx-background-color: #faf8f7;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="52.0" fitWidth="83.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Imagens/Senac_logo.png" />
                    </image>
                </ImageView>
            </children>
        </Pane>
    </top>

    <!-- Aqui entra o componente reutilizável do painel lateral -->
    <left>
        <PainelLateralComponent BorderPane.alignment="CENTER" />
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: #0000;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>
                <Label alignment="CENTER" text="Gerenciamento de Turmas" textFill="#004587">
                    <font>
                        <Font name="Verdana Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets left="100.0" />
                    </VBox.margin>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtBusca" prefHeight="35.0" prefWidth="125.0" promptText="Buscar..." HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="Verdana" size="12.0" />
                            </font></TextField>
                        <Button minHeight="35.0" minWidth="125.0" mnemonicParsing="false" onAction="#btnPesquisarClick" text="Buscar">
                            <styleClass>
                                <String fx:value="btn-cinza" />
                                <String fx:value="btn-cinza" />
                            </styleClass>
                        </Button>
                        <Button minHeight="35.0" minWidth="125.0" mnemonicParsing="false" onAction="#abrirTelaCadastroPopUp" prefWidth="150.0" styleClass="btn-azul" text="Adicionar Turma" />
                    </children>
                </HBox>
                <TableView fx:id="tabelaModelos" maxHeight="318.0" maxWidth="550.0">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="92.0" text="NOME" />
                        <TableColumn fx:id="colTelefone" prefWidth="75.0" text="TELEFONE" />
                        <TableColumn fx:id="colEmail" prefWidth="64.0" text="EMAIL" />
                        <TableColumn fx:id="colDataNascimento" prefWidth="145.0" text="DATA DE NASCIMENTO" />
                        <TableColumn fx:id="colAcoes" text="AÇÕES" />
                    </columns>
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </TableView>
            </children>
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
            <BorderPane.margin>
                <Insets left="10.0" />
            </BorderPane.margin>
            <padding>
                <Insets top="25.0" />
            </padding>
        </VBox>
    </center>
    <top>
        <Pane prefHeight="70.0" prefWidth="600.0" style="-fx-background-color: #faf8f7;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="52.0" fitWidth="83.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Imagens/Senac_logo.png" />
                    </image></ImageView>
            </children>
        </Pane>
    </top>
</BorderPane>
