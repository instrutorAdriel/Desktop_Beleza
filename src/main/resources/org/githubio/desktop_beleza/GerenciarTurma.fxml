<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.githubio.desktop_beleza.components.*?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1000.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.githubio.desktop_beleza.controller.GerenciarTurmaController">

    <!-- TOPO COM LOGO (exigido pelo projeto antigo) -->
    <top>
        <Pane prefHeight="70.0" prefWidth="600.0" style="-fx-background-color: #faf8f7;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="52.0" fitWidth="83.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Imagens/Senac_logo.png" />
                    </image>
                </ImageView>
            </children>
        </Pane>
    </top>

    <!-- PAINEL LATERAL (exigido pelo projeto antigo) -->
    <left>
        <PainelLateralComponent BorderPane.alignment="CENTER" />
    </left>

    <!-- ===== SEGUNDA TELA, COM OS IDS DO CONTROLLER ANTIGO ===== -->
    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <Label styleClass="title-2" style="-fx-font-weight: bold;" text="Gerenciamento de Turmas" />

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <!-- BUSCA + TABELA DE TURMAS -->
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <TextField fx:id="txtBusca" promptText="Buscar..." HBox.hgrow="ALWAYS" />
                                    <Button minWidth="100.0" mnemonicParsing="false" onAction="#btnPesquisarClick" text="Buscar" />
                                </children>
                            </HBox>

                            <TableView fx:id="tabelaUsuarios" VBox.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colTurma" prefWidth="200.0" text="Nome da Turma" />
                                    <TableColumn fx:id="colTurno" prefWidth="100.0" text="Turno" />
                                    <TableColumn fx:id="colInstrutor" prefWidth="140.0" text="Instrutor" />
                                    <TableColumn fx:id="colStatus" prefWidth="100.0" text="Situação" />
                                    <TableColumn fx:id="colAcoes" prefWidth="100.0" text="Ações" />
                                </columns>
                            </TableView>
                        </children>
                    </VBox>

                    <!-- FORMULÁRIO DE NOVA TURMA -->
                    <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-default; -fx-border-radius: 8; -fx-background-radius: 8;">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                        <children>
                            <Label styleClass="title-4" style="-fx-font-weight: bold;" text="Cadastrar Turma" />

                            <VBox spacing="4.0">
                                <children>
                                    <Label text="Identificação da Turma" />
                                    <TextField fx:id="txtNomeTurma" promptText="Ex: Cabeleireiro 2026.1 - Matutino" />
                                </children>
                            </VBox>

                            <VBox spacing="4.0">
                                <children>
                                    <Label text="Status da Turma" />
                                    <ComboBox fx:id="cbStatusTurma" maxWidth="1.7976931348623157E308" promptText="Selecione..." />
                                </children>
                            </VBox>

                            <Button maxWidth="1.7976931348623157E308" onAction="#abrirTelaCadastroPopUp" styleClass="accent" text="Cadastrar Turma">
                                <VBox.margin>
                                    <Insets top="10.0" />
                                </VBox.margin>
                            </Button>
                        </children>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>