<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.githubio.desktop_beleza.components.*?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefWidth="950.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.githubio.desktop_beleza.controller.GerenciarTurmaController">
    <top>
        <Pane prefHeight="70.0" prefWidth="600.0" style="-fx-background-color: #faf8f7;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="52.0" fitWidth="83.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Imagens/Senac_logo.png" />
                    </image>
                </ImageView>
            </children>
        </Pane>
    </top>

    <!-- Aqui entra o componente reutilizável do painel lateral -->
    <left>
        <PainelLateralComponent BorderPane.alignment="CENTER" />
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: #0000;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>
                <Label alignment="CENTER" text="Gerenciamento de Turmas" textFill="#004587">
                    <font>
                        <Font name="Verdana Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets left="100.0" />
                    </VBox.margin>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtBusca" maxWidth="850.0" minWidth="850.0" prefHeight="35.0" prefWidth="850.0" promptText="Buscar..." HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="Verdana" size="12.0" />
                            </font>
                     <HBox.margin>
                        <Insets bottom="10.0" right="10.0" />
                     </HBox.margin></TextField>
                        <Button minHeight="35.0" minWidth="125.0" mnemonicParsing="false" onAction="#btnPesquisarClick" text="Buscar">
                            <styleClass>
                                <String fx:value="btn-cinza" />
                                <String fx:value="btn-cinza" />
                            </styleClass>
                        </Button>
                        <Button minHeight="35.0" minWidth="125.0" mnemonicParsing="false" onAction="#abrirTelaCadastroPopUp" prefWidth="150.0" styleClass="btn-azul" text="Adicionar Turma">
                     <HBox.margin>
                        <Insets right="30.0" />
                     </HBox.margin></Button>
                    </children>
                </HBox>
                <TableView fx:id="tabelaUsuarios" maxHeight="1.7976931348623157E308" maxWidth="850.0" minWidth="850.0" prefWidth="850.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colTurma" prefWidth="100.0" text="TURMA" />
                        <TableColumn fx:id="colTurno" prefWidth="100.0" text="TURNO" />
                        <TableColumn fx:id="colInstrutor" prefWidth="100.0" text="INSTRUTOR" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="STATUS" />
                        <TableColumn fx:id="colAcoes" prefWidth="100.0" text="AÇÕES" />
                    </columns>
                    <VBox.margin>
                        <Insets bottom="25.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </TableView>
            </children>
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
            <BorderPane.margin>
                <Insets left="10.0" />
            </BorderPane.margin>
            <padding>
                <Insets top="25.0" />
            </padding>
        </VBox>
    </center>
    <top>
        <Pane prefHeight="70.0" prefWidth="600.0" style="-fx-background-color: #faf8f7;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="52.0" fitWidth="83.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Imagens/Senac_logo.png" />
                    </image></ImageView>
            </children>
        </Pane>
    </top>
</BorderPane>
