<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.githubio.desktop_beleza.components.*?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.githubio.desktop_beleza.controller.AgendaController">

    <!-- Menu lateral unificado e reutilizável -->
    <left>
        <PainelLateralComponent BorderPane.alignment="CENTER" />
    </left>

    <!-- CONTEÚDO PRINCIPAL DA AGENDA -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f5f7; -fx-background: #f4f5f7;" BorderPane.alignment="CENTER">
            <VBox spacing="20.0" style="-fx-background-color: #f4f5f7;">
                <padding>
                    <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
                </padding>
                <children>

                    <!-- TÍTULO: Visão Geral -->
                    <Label fx:id="welcomeText" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Visão Geral" />

                    <!-- CARDS DE MÉTRICAS: Práticas do Mês, Vagas Ocupadas, Turmas Ativas -->
                    <HBox spacing="15.0">
                        <children>
                            <!-- Card: Práticas do Mês -->
                            <VBox prefWidth="200.0" spacing="5.0" styleClass="card-metrica" HBox.hgrow="ALWAYS">
                                <padding>
                                    <Insets bottom="15.0" left="18.0" right="18.0" top="15.0" />
                                </padding>
                                <children>
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Práticas do Mês" />
                                    <Label fx:id="lblTotalMes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="0" />
                                </children>
                            </VBox>

                            <!-- Card: Vagas Ocupadas -->
                            <VBox prefWidth="200.0" spacing="5.0" styleClass="card-metrica" HBox.hgrow="ALWAYS">
                                <padding>
                                    <Insets bottom="15.0" left="18.0" right="18.0" top="15.0" />
                                </padding>
                                <children>
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Vagas Ocupadas" />
                                    <Label fx:id="lblConcluidos" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="0%" />
                                </children>
                            </VBox>

                            <!-- Card: Turmas Ativas -->
                            <VBox prefWidth="200.0" spacing="5.0" styleClass="card-metrica" HBox.hgrow="ALWAYS">
                                <padding>
                                    <Insets bottom="15.0" left="18.0" right="18.0" top="15.0" />
                                </padding>
                                <children>
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Turmas Ativas" />
                                    <Label fx:id="lblPendentes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #004a8d;" text="0" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- CARD: Próximas Práticas Agendadas + Tabela -->
                    <VBox spacing="15.0" styleClass="card-principal" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                        <children>
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Próximas Práticas Agendadas" />

                            <!-- BARRA DE FILTROS -->
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <children>
                                    <VBox spacing="3.0">
                                        <children>
                                            <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Data da Prática" />
                                            <DatePicker fx:id="dpData" prefWidth="140.0" promptText="Selecione..." />
                                        </children>
                                    </VBox>

                                    <VBox spacing="3.0">
                                        <children>
                                            <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Unidade" />
                                            <ComboBox fx:id="cbUnidade" prefWidth="170.0" promptText="Todas as Unidades" />
                                        </children>
                                    </VBox>

                                    <VBox spacing="3.0">
                                        <children>
                                            <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Tipo de Serviço" />
                                            <ComboBox fx:id="txtServico" prefWidth="180.0" promptText="Tipo de Serviço" />
                                        </children>
                                    </VBox>

                                    <VBox spacing="3.0">
                                        <children>
                                            <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Modelo" />
                                            <ComboBox fx:id="txtModelo" prefWidth="160.0" promptText="Modelos" />
                                        </children>
                                    </VBox>

                                    <VBox spacing="3.0">
                                        <children>
                                            <Label style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Horário" />
                                            <TextField fx:id="txtHorario" prefWidth="160.0" promptText="HH:mm" />
                                        </children>
                                    </VBox>

                                    <!-- Botão Ver semana / Ver todos -->
                                    <VBox alignment="BOTTOM_LEFT" spacing="3.0">
                                        <children>
                                            <Label style="-fx-font-size: 11px;" text=" " />
                                            <Button fx:id="btnVerTodos" mnemonicParsing="false" onAction="#onVerTodosClick" styleClass="btn-link" text="Ver semana" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <!-- BARRA DE AÇÕES (Salvar agendamento) -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Button id="btn-salvar" mnemonicParsing="false" onAction="#onSalvarButtonClick" prefWidth="140.0" styleClass="btn-azul" text="Salvar" />
                                </children>
                            </HBox>

                            <!-- Separador visual -->
                            <Separator />

                            <!-- TABELA DE AGENDAMENTOS -->
                            <TableView fx:id="tabelaAgenda" minHeight="300.0" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colData" minWidth="-1.0" prefWidth="120.0" text="Data " />
                                    <TableColumn fx:id="colServico" minWidth="-1.0" prefWidth="160.0" text="Procedimento" />
                                    <TableColumn fx:id="colModelo" minWidth="-1.0" prefWidth="120.0" text="Unidade" />
                                    <TableColumn fx:id="colHorario" minWidth="-1.0" prefWidth="140.0" text="Horário" />
                                    <TableColumn fx:id="colStatus" minWidth="-1.0" prefWidth="96.0" text="Status" />
                                    <TableColumn fx:id="colAcao" minWidth="-1.0" prefWidth="80.0" text="" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
