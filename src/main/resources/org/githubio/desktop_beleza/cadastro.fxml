<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="700.0" prefWidth="1100.0" styleClass="tela-atualizar-senha" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.githubio.desktop_beleza.controller.CadastroController">
   <stylesheets>
      <URL value="@css/style.css" />
   </stylesheets>
   <children>
      <HBox>
         <children>
            <VBox alignment="CENTER" spacing="18.0" styleClass="formulario-atualizar-senha" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="32.0" left="44.0" right="44.0" top="32.0" />
               </padding>
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="titulo-formulario" text="Cadastro">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                        <Label styleClass="descricao-formulario" text="Inicie o seu cadastro." />
                     </children>
                     <VBox.margin>
                        <Insets bottom="4.0" />
                     </VBox.margin>
                  </VBox>
                  <VBox>
                     <children>
                        <Label text="Nome" />
                        <TextField fx:id="campoNome" prefHeight="45.0" promptText="Digite seu nome" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="rotulo-formulario" text="E-mail institucional" />
                        <TextField fx:id="campoEmail" prefHeight="45.0" promptText="seu.email@df.senac.br" styleClass="campo-formulario" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="rotulo-formulario" text="Senha" />
                        <StackPane prefHeight="45.0" styleClass="campo-senha">
                           <PasswordField fx:id="campoSenha" prefHeight="45.0" promptText="Digite sua senha" styleClass="campo-formulario" />
                           <TextField fx:id="campoNovaSenhaVisivel" managed="false" prefHeight="45.0" promptText="Digite sua nova senha" styleClass="campo-formulario" visible="false" />
                           <Button fx:id="btnToggleNovaSenha" styleClass="botao-olho" StackPane.alignment="CENTER_RIGHT">
                              <graphic>
                                 <ImageView fx:id="imgOlhoNova" fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                       <Image url="@Imagens/eyeOpen 1.png" />
                                    </image>
                                 </ImageView>
                              </graphic>
                           </Button>
                        </StackPane>
                     </children>
                  </VBox>
                  <VBox fx:id="vboxValidacoes" managed="false" maxWidth="1.7976931348623157E308" spacing="2.0" styleClass="validacoes-senha" visible="false">
                     <children>
                        <Label fx:id="lblMaiuscula" styleClass="validacao-senha" text="❌ Letra maiúscula" />
                        <Label fx:id="lblMinuscula" styleClass="validacao-senha" text="❌ Letra minúscula" />
                        <Label fx:id="lblNumero" styleClass="validacao-senha" text="❌ Número" />
                        <Label fx:id="lblEspecial" styleClass="validacao-senha" text="❌ Caractere especial" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="rotulo-formulario" text="Confirmar Senha" />
                        <StackPane prefHeight="45.0" styleClass="campo-senha">
                           <PasswordField fx:id="campoConfirmarSenha" prefHeight="45.0" promptText="Digite novamente sua senha" styleClass="campo-formulario" />
                           <TextField fx:id="campoConfirmarSenhaVisivel" managed="false" prefHeight="45.0" promptText="Digite novamente sua senha" styleClass="campo-formulario" visible="false" />
                           <Button fx:id="btnToggleConfirmarSenha" styleClass="botao-olho" StackPane.alignment="CENTER_RIGHT">
                              <graphic>
                                 <ImageView fx:id="imgOlhoConfirmar" fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                       <Image url="@Imagens/eyeOpen 1.png" />
                                    </image>
                                 </ImageView>
                              </graphic>
                           </Button>
                        </StackPane>
                     </children>
                  </VBox>
                  <VBox spacing="10.0" styleClass="acoes-formulario">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCadastrarClick" prefHeight="45.0" styleClass="botao-principal" text="Cadastrar-se" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onVoltarClick" prefHeight="45.0" styleClass="botao-secundario" text="Voltar para o login" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefWidth="340.0" spacing="38.0" style="-fx-background-color: #004786;" styleClass="painel-decorativo-atualizar" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="36.0" left="30.0" right="30.0" top="36.0" />
               </padding>
               <children>
                  <ImageView fitHeight="130.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@Imagens/Senac_logo.png" />
                     </image>
                  </ImageView>
                  <Label maxWidth="460.0" styleClass="texto-decorativo" text="A educação transforma. Sua jornada começa aqui." textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</StackPane>
