<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane
        maxHeight="-Infinity"
        maxWidth="-Infinity"
        minHeight="-Infinity"
        minWidth="-Infinity"
        prefHeight="400.0"
        prefWidth="600.0"
        stylesheets="@css/style.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.githubio.desktop_beleza.controller.LoginController">

   <!-- LADO ESQUERDO -->
   <left>
      <AnchorPane
              prefHeight="260.0"
              prefWidth="140.0"
              style="-fx-background-color: #faf8f7;"
              BorderPane.alignment="CENTER" />
   </left>

   <!-- CENTRO -->
   <center>

      <VBox
              alignment="CENTER"
              prefHeight="475.0"
              prefWidth="504.0"
              spacing="10.0"
              style="-fx-background-color: #0000;"
              BorderPane.alignment="CENTER">

         <children>

            <!-- TÍTULO -->
            <Label
                    text="Bem-vindo"
                    textFill="#004587">

               <font>
                  <Font
                          name="Verdana Bold"
                          size="28.0" />
               </font>

            </Label>

            <!-- E-MAIL -->
            <TextField
                    fx:id="Email"
                    alignment="TOP_LEFT"
                    maxHeight="500.0"
                    maxWidth="500.0"
                    prefHeight="24.0"
                    prefWidth="110.0"
                    promptText="E-mail"
                    style="-fx-background-color: transparent; -fx-border-style: hidden hidden solid hidden;"
                    styleClass="rounded">

               <opaqueInsets>
                  <Insets />
               </opaqueInsets>

               <VBox.margin>
                  <Insets
                          left="100.0"
                          right="100.0" />
               </VBox.margin>

               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>

               <padding>
                  <Insets right="100.0" />
               </padding>

            </TextField>

            <!-- SENHA -->
            <HBox
                    alignment="CENTER"
                    maxWidth="500.0">

               <VBox.margin>
                  <Insets
                          left="100.0"
                          right="100.0" />
               </VBox.margin>

               <children>

                  <StackPane
                          prefHeight="27.0"
                          prefWidth="300.0"
                          maxWidth="500.0"
                          HBox.hgrow="ALWAYS">

                     <children>

                        <!-- CAMPO DE SENHA OCULTO -->
                        <PasswordField
                                fx:id="Senha"
                                prefHeight="27.0"
                                prefWidth="300.0"
                                maxWidth="500.0"
                                promptText="Senha"
                                style="-fx-background-color: transparent; -fx-border-style: hidden hidden solid hidden;"
                                styleClass="rounded" />

                        <!-- CAMPO DE SENHA VISÍVEL -->
                        <TextField
                                fx:id="SenhaVisible"
                                visible="false"
                                managed="false"
                                prefHeight="27.0"
                                prefWidth="300.0"
                                maxWidth="500.0"
                                promptText="Senha"
                                style="-fx-background-color: transparent; -fx-border-style: hidden hidden solid hidden;"
                                styleClass="rounded" />

                        <!-- BOTÃO DO OLHO -->
                        <Button
                                mnemonicParsing="false"
                                onAction="#alternarVisibilidadeSenha"
                                prefHeight="27.0"
                                prefWidth="32.0"
                                style="-fx-background-color: transparent; -fx-padding: 0;">

                           <graphic>

                              <ImageView
                                      fx:id="imgOlho"
                                      fitHeight="20.0"
                                      fitWidth="20.0"
                                      pickOnBounds="true"
                                      preserveRatio="true">

                                 <image>
                                    <Image url="@Imagens/olho-fechado.png" />
                                 </image>

                              </ImageView>

                           </graphic>

                           <StackPane.alignment>
                              <Pos fx:constant="CENTER_RIGHT" />
                           </StackPane.alignment>

                           <StackPane.margin>
                              <Insets right="5.0" />
                           </StackPane.margin>

                        </Button>

                     </children>

                  </StackPane>

               </children>

            </HBox>

            <!-- ESQUECEU A SENHA -->
            <Hyperlink
                    alignment="CENTER_RIGHT"
                    onAction="#irParaAtualizarSenha"
                    text="Esqueceu a senha?"
                    textFill="#004a8d"
                    underline="true">

               <VBox.margin>
                  <Insets left="300.0" />
               </VBox.margin>

               <font>
                  <Font size="14.0" />
               </font>

               <opaqueInsets>
                  <Insets />
               </opaqueInsets>

            </Hyperlink>

            <!-- LOGIN -->
            <Button
                    mnemonicParsing="false"
                    onAction="#onLoginButtonClick"
                    prefHeight="27.0"
                    prefWidth="90.0"
                    styleClass="btn-cinza"
                    text="Login">

               <padding>
                  <Insets
                          bottom="1.6"
                          left="25.0"
                          right="25.0"
                          top="1.6" />
               </padding>

            </Button>

            <!-- CADASTRO -->
            <Button
                    mnemonicParsing="false"
                    onAction="#irParaCadastro"
                    prefHeight="27.0"
                    styleClass="btn-azul"
                    text="Registre-se"
                    textFill="#e4e4e4">

               <VBox.margin>
                  <Insets />
               </VBox.margin>

               <padding>
                  <Insets
                          bottom="2.0"
                          left="10.0"
                          right="10.0"
                          top="2.0" />
               </padding>

            </Button>

         </children>

         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>

      </VBox>

   </center>

   <!-- LADO DIREITO -->
   <right>
      <AnchorPane
              prefHeight="260.0"
              prefWidth="140.0"
              style="-fx-background-color: #faf8f7;"
              BorderPane.alignment="CENTER" />
   </right>

   <!-- TOPO -->
   <top>

      <AnchorPane
              prefHeight="70.0"
              prefWidth="600.0"
              style="-fx-background-color: #faf8f7;"
              BorderPane.alignment="CENTER">

         <children>

            <ImageView
                    fitHeight="52.0"
                    fitWidth="83.0"
                    layoutX="14.0"
                    layoutY="14.0"
                    pickOnBounds="true"
                    preserveRatio="true">

               <image>
                  <Image url="@Imagens/Senac_logo.png" />
               </image>

            </ImageView>

         </children>

      </AnchorPane>

   </top>

   <!-- RODAPÉ -->
   <bottom>

      <AnchorPane
              prefHeight="70.0"
              prefWidth="600.0"
              style="-fx-background-color: #faf8f7;"
              BorderPane.alignment="CENTER" />

   </bottom>

</BorderPane>