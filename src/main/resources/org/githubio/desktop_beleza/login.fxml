<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="768.0" prefWidth="1366.0"
           stylesheets="@css/style.css"
           styleClass="login-root"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.githubio.desktop_beleza.controller.LoginController">

   <children>
      <HBox maxHeight="640.0" maxWidth="1120.0"
            prefHeight="620.0" prefWidth="1080.0"
            styleClass="login-card">

         <VBox alignment="CENTER" spacing="18.0"
               minWidth="430.0" prefWidth="500.0"
               HBox.hgrow="ALWAYS" styleClass="login-form">

            <padding>
               <Insets top="42.0" right="58.0" bottom="38.0" left="58.0"/>
            </padding>

            <ImageView fitHeight="58.0" fitWidth="105.0"
                       preserveRatio="true" pickOnBounds="true">
               <image>
                  <Image url="@Imagens/Senac_logo.png"/>
               </image>
               <VBox.margin>
                  <Insets bottom="4.0"/>
               </VBox.margin>
            </ImageView>

            <Label text="Bem-vindo" styleClass="login-title"/>
            <Label text="Acesse sua conta para continuar"
                   styleClass="login-subtitle"/>

            <VBox spacing="7.0" maxWidth="390.0" HBox.hgrow="ALWAYS">
               <Label text="E-mail" styleClass="field-label"/>
               <TextField fx:id="Email" promptText="Digite seu e-mail"
                          prefHeight="48.0" styleClass="login-input"/>
            </VBox>

            <VBox spacing="7.0" maxWidth="390.0">
               <Label text="Senha" styleClass="field-label"/>
               <StackPane prefHeight="48.0" maxWidth="390.0"
                          styleClass="password-container">
                  <PasswordField fx:id="Senha" promptText="Digite sua senha"
                                 prefHeight="48.0" styleClass="password-input"/>
                  <TextField fx:id="SenhaVisivel" promptText="Digite sua senha"
                             managed="false" visible="false"
                             prefHeight="48.0" styleClass="password-input"/>
                  <Button fx:id="btnToggleSenha"
                          onAction="#alternarVisibilidadeSenha"
                          styleClass="password-toggle"
                          StackPane.alignment="CENTER_RIGHT">
                     <graphic>
                        <ImageView fx:id="imgOlho" fitHeight="17.0" fitWidth="17.0"
                                   preserveRatio="true" pickOnBounds="true">
                           <image>
                              <Image url="@Imagens/eyeClosed 1.png"/>
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </StackPane>
            </VBox>

            <HBox alignment="CENTER_RIGHT" maxWidth="390.0">
               <Region HBox.hgrow="ALWAYS"/>
               <Hyperlink text="Esqueceu a senha?"
                          onAction="#irParaAtualizarSenha"
                          styleClass="forgot-link"/>
            </HBox>

            <Button text="Entrar no sistema"
                    onAction="#onLoginButtonClick"
                    maxWidth="390.0" prefHeight="49.0"
                    styleClass="login-primary"/>

            <HBox alignment="CENTER" spacing="5.0">
               <Label text="Ainda não tem uma conta?"
                      styleClass="register-text"/>
               <Hyperlink text="Registre-se"
                          onAction="#irParaCadastro"
                          styleClass="register-link"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Desktop Beleza • SENAC"
                   styleClass="login-footer"/>
         </VBox>

         <VBox alignment="CENTER" spacing="22.0"
               minWidth="390.0" prefWidth="470.0"
               styleClass="login-decorative-panel" HBox.hgrow="ALWAYS">
            <padding>
               <Insets top="50.0" right="42.0" bottom="50.0" left="42.0"/>
            </padding>

            <StackPane styleClass="decorative-mark">
               <Label text="B" styleClass="decorative-mark-letter"/>
            </StackPane>

            <VBox alignment="CENTER" spacing="10.0">
               <Label text="Beleza Desktop"
                      wrapText="true" styleClass="decorative-title"/>
               <Label text="Organização, praticidade e cuidado em um só lugar."
                      wrapText="true" textAlignment="CENTER"
                      styleClass="decorative-description"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12.0" styleClass="decorative-info">
               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <StackPane styleClass="feature-icon">
                     <Label text="✓" styleClass="feature-check"/>
                  </StackPane>
                  <Label text="Gestão simples e organizada" styleClass="feature-text"/>
               </HBox>
               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <StackPane styleClass="feature-icon">
                     <Label text="✓" styleClass="feature-check"/>
                  </StackPane>
                  <Label text="Acesso às ferramentas do sistema" styleClass="feature-text"/>
               </HBox>
               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <StackPane styleClass="feature-icon">
                     <Label text="✓" styleClass="feature-check"/>
                  </StackPane>
                  <Label text="Uma experiência mais intuitiva" styleClass="feature-text"/>
               </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="SENAC • Educação profissional"
                   styleClass="decorative-footer"/>
         </VBox>
      </HBox>
   </children>
</StackPane>