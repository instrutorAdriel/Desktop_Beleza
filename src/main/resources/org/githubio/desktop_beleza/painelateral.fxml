<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<fx:root type="javafx.scene.layout.VBox" prefWidth="180.0" spacing="10.0" styleClass="sidebar" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets top="20.0" />
   </padding>
   <children>
      <VBox spacing="8.0">
         <padding>
            <Insets left="15.0" right="15.0" />
         </padding>
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaPaginaInicial" styleClass="btn-cinza" text="Página inicial">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaModelos" styleClass="btn-cinza" text="Modelos">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaServicos" styleClass="btn-cinza" text="Serviços">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaUnidades" styleClass="btn-cinza" text="Unidades">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaTurmas" styleClass="btn-cinza" text="Turmas">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
         </children>
      </VBox>
      <VBox styleClass="sidebar-spacer" VBox.vgrow="ALWAYS" />
       <VBox alignment="CENTER" prefHeight="80.0">
          <padding>
             <Insets left="15.0" right="15.0" />
          </padding>
          <children>
             <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sairDoSistema" style="-fx-alignment: CENTER;" styleClass="btn-azul" text="Sair">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</fx:root>