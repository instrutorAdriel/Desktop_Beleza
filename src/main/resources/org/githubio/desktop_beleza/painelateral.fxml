<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root prefWidth="230.0" spacing="10.0" styleClass="sidebar" type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
    </padding>
    <children>
        <!-- CABEÇALHO -->
        <Label styleClass="sidebar-titulo" />
        <Label styleClass="sidebar-subtitulo" />

        <!-- LISTA DE BOTÕES DE NAVEGAÇÃO (LARANJA SENAC) -->
        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
            <children>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaPaginaInicial" prefHeight="40.0" text="Página inicial" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaModelos" prefHeight="40.0" text="Modelos" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaServicos" prefHeight="40.0" text="Serviços" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaUnidades" prefHeight="40.0" text="Unidades" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaTurmas" prefHeight="40.0" text="Turmas" />
            </children>
        </VBox>

        <!-- BOTÃO DE LOGOUT -->
        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sairDoSistema" prefHeight="38.0" styleClass="danger-senac" text="Sair do Sistema" />
    </children>
</fx:root>
