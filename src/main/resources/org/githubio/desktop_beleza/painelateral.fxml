<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="javafx.scene.layout.VBox" prefWidth="230.0" spacing="10.0" styleClass="sidebar" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
   </padding>
   <children>
      <VBox spacing="4.0">
         <padding>
            <Insets bottom="15.0" left="5.0" />
         </padding>
         <children>
            <Label styleClass="sidebar-titulo" text="SISBE" />
            <Label styleClass="sidebar-subtitulo" text="Painel do Instrutor" />
         </children>
      </VBox>
      <Button maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#trocarTelaParaPaginaInicial" text="Página inicial" />
      <Button maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#trocarTelaParaModelos" text="Modelos" />
      <Button maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#trocarTelaParaProcedimentos" text="Procedimentos" />
      <Button maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#trocarTelaParaUnidades" text="Unidades" />
      <Button maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#trocarTelaParaTurmas" text="Turmas" />
      <VBox VBox.vgrow="ALWAYS" />
      <Button maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#sairDoSistema" styleClass="danger-senac" text="Sair do Sistema" />
   </children>
</fx:root>