<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<fx:root type="javafx.scene.layout.VBox" prefWidth="230.0" spacing="10.0" styleClass="sidebar" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets top="20.0" />
   </padding>
   <children>
      <VBox spacing="10.0">
         <padding>
            <Insets left="15.0" right="15.0" />
         </padding>
         <children>
            <Label styleClass="sidebar-titulo" text="SENAC" />
            <Label styleClass="sidebar-subtitulo" text="Painel de Gestão">
               <VBox.margin><Insets bottom="22.0" /></VBox.margin>
            </Label>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaPaginaInicial" styleClass="sidebar-button" text="Dashboard">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaUnidades" styleClass="sidebar-button" text="Unidades">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaTurmas" styleClass="sidebar-button" text="Turmas">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaModelos" styleClass="sidebar-button" text="Modelos">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#trocarTelaParaServicos" styleClass="sidebar-button" text="Serviços">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
         </children>
      </VBox>
      <VBox style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" />
      <VBox alignment="CENTER" prefHeight="52.0">
         <padding><Insets left="15.0" right="15.0" /></padding>
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sairDoSistema" styleClass="danger-senac" text="Sair do Sistema">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</fx:root>
