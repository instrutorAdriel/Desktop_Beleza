<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>
<?import org.githubio.desktop_beleza.components.PainelLateralComponent?>

<BorderPane
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.githubio.desktop_beleza.controller.UnidadeController"
        stylesheets="@css/style.css">

    <top>
        <Pane prefHeight="70" style="-fx-background-color: #faf8f7;">
            <children>
                <ImageView
                        fitHeight="52"
                        fitWidth="83"
                        layoutX="14"
                        layoutY="14"
                        preserveRatio="true">
                    <image>
                        <Image url="@Imagens/Senac_logo.png"/>
                    </image>
                </ImageView>
            </children>
        </Pane>
    </top>

    <left>
        <PainelLateralComponent BorderPane.alignment="CENTER"/>
    </left>

    <center>

        <VBox spacing="22" style="-fx-background-color: #f5f7fb;">

            <padding>
                <Insets
                        top="30"
                        left="32"
                        right="32"
                        bottom="32"/>
            </padding>

            <Label
                    text="Unidades SENAC"
                    textFill="#17324d">
                <font>
                    <Font name="Verdana Bold" size="26"/>
                </font>
            </Label>

            <HBox spacing="22" VBox.vgrow="ALWAYS">

                <VBox
                        spacing="12"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e3e9f0; -fx-border-radius: 12;">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="Lista de unidades" textFill="#17324d">
                        <font>
                            <Font name="Verdana Bold" size="16"/>
                        </font>
                    </Label>

                    <TableView
                            fx:id="tabelaUnidades"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color: white; -fx-background-radius: 8;">
                        <placeholder>
                            <Label text="Nenhuma unidade cadastrada." textFill="#758397"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colNome" text="Nome da unidade" prefWidth="190"/>
                            <TableColumn fx:id="colEndereco" text="Endereço" prefWidth="260"/>
                            <TableColumn fx:id="colSituacao" text="Situação" prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox
                        prefWidth="310"
                        minWidth="280"
                        spacing="18"
                        style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e3e9f0; -fx-border-radius: 12;">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="Dados da unidade" textFill="#17324d">
                        <font>
                            <Font name="Verdana Bold" size="16"/>
                        </font>
                    </Label>

                    <VBox spacing="7">
                        <Label text="Nome da unidade" textFill="#425466"/>
                        <TextField
                                fx:id="txtNome"
                                promptText="Ex.: SENAC Taguatinga"
                                style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #d7e0e9; -fx-padding: 10;"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Endereço" textFill="#425466"/>
                        <TextField
                                fx:id="txtEndereco"
                                promptText="Ex.: QNG AE 01, Taguatinga Norte"
                                style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #d7e0e9; -fx-padding: 10;"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Situação" textFill="#425466"/>
                        <ComboBox
                                fx:id="cbSituacao"
                                maxWidth="Infinity"
                                promptText="Selecione a situação"
                                style="-fx-background-radius: 7; -fx-border-radius: 7;"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                            maxWidth="Infinity"
                            text="Salvar unidade"
                            style="-fx-background-color: #004a8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 11 16;"
                            onAction="#salvar"/>

                    <Button
                            maxWidth="Infinity"
                            text="Limpar formulário"
                            style="-fx-background-color: #edf2f7; -fx-text-fill: #24445f; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 16;"
                            onAction="#novoCadastro"/>
                </VBox>
            </HBox>

        </VBox>

    </center>

</BorderPane>