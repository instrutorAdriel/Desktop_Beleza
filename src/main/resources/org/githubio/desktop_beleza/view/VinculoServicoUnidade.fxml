<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.githubio.desktop_beleza.controller.VinculoServicoUnidadeController"
      stylesheets="@../css/style.css"
      spacing="15"
      prefWidth="380"
      style="-fx-background-color: #faf8f7;">

    <padding>
        <Insets top="25" left="25" right="25" bottom="25"/>
    </padding>

    <Label text="Adicionar serviço à unidade" textFill="#004587">
        <font>
            <Font name="Verdana Bold" size="18"/>
        </font>
    </Label>

    <VBox spacing="5">
        <Label text="Unidade"/>
        <ComboBox fx:id="cbUnidade"
                  maxWidth="Infinity"
                  promptText="Selecione a unidade"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Serviço"/>
        <ComboBox fx:id="cbServico"
                  maxWidth="Infinity"
                  promptText="Selecione o serviço"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar"
                styleClass="btn-cinza"
                onAction="#cancelar"/>
        <Button text="Vincular"
                styleClass="btn-azul"
                onAction="#vincular"/>
    </HBox>

</VBox>
