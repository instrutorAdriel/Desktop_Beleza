<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.githubio.desktop_beleza.components.PainelLateralComponent?>

<BorderPane prefHeight="730.0" prefWidth="1360.0" styleClass="app-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.githubio.desktop_beleza.controller.ServicosController">
    <left>
        <PainelLateralComponent BorderPane.alignment="CENTER" />
    </left>
    <center>
        <VBox spacing="22.0" styleClass="content-area">
            <padding><Insets bottom="26.0" left="25.0" right="18.0" top="30.0" /></padding>
            <children>
                <Label styleClass="page-title" text="Gerenciamento de Servi&#xE7;os">
                    <font><Font name="Verdana Bold" size="26.0" /></font>
                </Label>
                <TableView fx:id="tabelaServicos" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="180.0" text="NOME" />
                        <TableColumn fx:id="colDescricao" prefWidth="460.0" text="DESCRI&#xC7;&#xC3;O" />
                        <TableColumn fx:id="colAcoes" prefWidth="120.0" text="A&#xC7;&#xD5;ES" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
    <right>
        <VBox prefWidth="300.0" styleClass="tools-panel-wrap" BorderPane.alignment="CENTER">
            <padding><Insets bottom="26.0" left="12.0" right="22.0" top="86.0" /></padding>
            <children>
                <VBox spacing="12.0" styleClass="model-tools-panel" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="22.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <Label styleClass="tools-panel-title" text="Servi&#xE7;os" />
                        <TextField fx:id="txtBuscar" promptText="Buscar servi&#xE7;o" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#buscar" styleClass="panel-button-primary" text="Buscar" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#abrirDialogoAdicionar" styleClass="panel-button-primary" text="Adicionar servi&#xE7;o" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </right>
</BorderPane>
