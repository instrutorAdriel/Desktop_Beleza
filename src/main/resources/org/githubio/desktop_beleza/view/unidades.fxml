<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #ffffff;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.githubio.desktop_beleza.controller.UnidadeController">

    <left>
        <VBox prefWidth="230.0" spacing="10.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <Region maxHeight="62.0" minHeight="62.0" prefHeight="62.0" />
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaPaginaInicial" prefHeight="40.0" styleClass="sidebar-nav-button" text="Página inicial" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaModelos" prefHeight="40.0" styleClass="sidebar-nav-button" text="Modelos" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaServicos" prefHeight="40.0" styleClass="sidebar-nav-button" text="Serviços" />
                        <Button maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="sidebar-nav-button" text="Unidades" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaTurmas" prefHeight="40.0" styleClass="sidebar-nav-button" text="Turmas" />
                    </children>
                </VBox>
                <Button maxWidth="1.7976931348623157E308" onAction="#sairDoSistema" prefHeight="38.0" styleClass="danger-senac" text="Sair do Sistema" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <Label style="-fx-text-fill: #1f2937; -fx-font-weight: bold;" text="Unidades SENAC">
                    <font>
                        <Font name="Verdana Bold" size="24.0" />
                    </font>
                </Label>
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tabelaUnidades" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4;" styleClass="unidades-table" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNome" prefWidth="260.0" reorderable="false" resizable="false" text="Nome da Unidade" />
                                <TableColumn fx:id="colEndereco" prefWidth="550.0" reorderable="false" resizable="false" text="Endereço" />
                                <TableColumn fx:id="colSituacao" prefWidth="190.0" reorderable="false" resizable="false" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <VBox minWidth="220.0" prefWidth="245.0" spacing="14.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 9; -fx-background-radius: 9;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label style="-fx-text-fill: #1f2937; -fx-font-weight: bold;" text="Editar Unidade">
                                    <font>
                                        <Font name="Verdana Bold" size="17.0" />
                                    </font>
                                </Label>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label style="-fx-text-fill: #334155;" text="Nome da Unidade" />
                                        <TextField fx:id="txtNome" promptText="Ex: SENAC Taguatinga" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1;" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label style="-fx-text-fill: #334155;" text="Endereço" />
                                        <TextField fx:id="txtEndereco" promptText="Ex: QNG AE 01, Taguatinga Norte" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1;" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label style="-fx-text-fill: #334155;" text="Status" />
                                        <ComboBox fx:id="cbSituacao" maxWidth="Infinity" promptText="Selecione..." style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1;" />
                                    </children>
                                </VBox>
                                <Button maxWidth="Infinity" onAction="#salvar" style="-fx-background-color: #004a8d; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 10 12;" text="Salvar Alterações">
                                    <VBox.margin>
                                        <Insets top="4.0" />
                                    </VBox.margin>
                                </Button>
                                <Button maxWidth="Infinity" onAction="#novoCadastro" style="-fx-background-color: #f7941d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 10 12;" text="Limpar" />
                                <Button maxWidth="Infinity" onAction="#abrirVinculoServico" style="-fx-background-color: #fff7ed; -fx-border-color: #f7941d; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #004a8d; -fx-cursor: hand; -fx-padding: 10 8;" text="Gerenciar serviços da unidade" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
