<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1050.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.githubio.desktop_beleza.controller.UnidadeController"
            stylesheets="@../css/style.css"
            style="-fx-background-color: #ffffff;">

    <top>

        <Pane prefHeight="70"
              style="-fx-background-color: #faf8f7;">

            <ImageView
                    fitHeight="52"
                    fitWidth="83"
                    layoutX="14"
                    layoutY="14"
                    preserveRatio="true">

                <image>
                    <Image url="@../images/senaclogo.png"/>
                </image>

            </ImageView>

        </Pane>

    </top>


    <left>
        <VBox prefWidth="230.0" spacing="10.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <VBox minHeight="46.0" prefHeight="46.0" maxHeight="46.0" />
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                    <children>
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaPaginaInicial" prefHeight="40.0" styleClass="sidebar-nav-button" text="Página inicial" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaModelos" prefHeight="40.0" styleClass="sidebar-nav-button" text="Modelos" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaServicos" prefHeight="40.0" styleClass="sidebar-nav-button" text="Serviços" />
                        <Button maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="sidebar-nav-button" text="Unidades" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#trocarTelaParaTurmas" prefHeight="40.0" styleClass="sidebar-nav-button" text="Turmas" />
                    </children>
                </VBox>
                <Button maxWidth="1.7976931348623157E308" onAction="#sairDoSistema" prefHeight="38.0" styleClass="danger-senac" text="Sair do Sistema" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
            </padding>
            <children>
                <Label text="Unidades SENAC"
                       style="-fx-text-fill: #1f2937; -fx-font-weight: bold;">
                    <font>
                        <Font name="Verdana Bold" size="24.0"/>
                    </font>
                </Label>
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tabelaUnidades" HBox.hgrow="ALWAYS"
                                   VBox.vgrow="ALWAYS"
                                   styleClass="unidades-table"
                                   style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4;">
                            <columns>
                                <TableColumn fx:id="colNome" prefWidth="260.0" reorderable="false" resizable="false"
                                             text="Nome da Unidade"/>
                                <TableColumn fx:id="colEndereco" prefWidth="550.0" reorderable="false" resizable="false"
                                             text="Endereço"/>
                                <TableColumn fx:id="colSituacao" prefWidth="190.0" reorderable="false" resizable="false"
                                             text="Status"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <VBox prefWidth="245.0" minWidth="220.0" spacing="14.0"
                              style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 9; -fx-background-radius: 9;">
                            <padding>
                                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                            </padding>
                            <children>
                                <Label text="Editar Unidade"
                                       style="-fx-text-fill: #1f2937; -fx-font-weight: bold;">
                                    <font>
                                        <Font name="Verdana Bold" size="17.0"/>
                                    </font>
                                </Label>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Nome da Unidade"
                                               style="-fx-text-fill: #334155;"/>
                                        <TextField fx:id="txtNome"
                                                   promptText="Ex: SENAC Taguatinga"
                                                   style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Endereço"
                                               style="-fx-text-fill: #334155;"/>
                                        <TextField fx:id="txtEndereco"
                                                   promptText="Ex: QNG AE 01, Taguatinga Norte"
                                                   style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Status"
                                               style="-fx-text-fill: #334155;"/>
                                        <ComboBox fx:id="cbSituacao"
                                                  maxWidth="Infinity"
                                                  promptText="Selecione..."
                                                  style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #cbd5e1;"/>
                                    </children>
                                </VBox>
                                <Button maxWidth="Infinity" text="Salvar Alterações"
                                        onAction="#salvar"
                                        style="-fx-background-color: #004a8d; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 10 12;">
                                    <VBox.margin>
                                        <Insets top="4.0"/>
                                    </VBox.margin>
                                </Button>
                                <Button maxWidth="Infinity" text="Novo Cadastro"
                                        onAction="#novoCadastro"
                                        style="-fx-background-color: #f7941d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 10 12;"/>
                                <Button maxWidth="Infinity"
                                        text="Adicionar serviço à unidade"
                                        onAction="#abrirVinculoServico"
                                        style="-fx-background-color: #fff7ed; -fx-border-color: #f7941d; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #004a8d; -fx-cursor: hand; -fx-padding: 10 8;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
